<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#07162d">
  <meta name="description" content="面向跨境业务的海外网络资源、住宅 IP、专线组网与技术支持服务。">
  <title>GlobalNet｜全球网络服务</title>
  <style>
    /* =========================================================
       快速自定义区：先修改这里的品牌色、品牌名和联系信息
       ========================================================= */
    :root {
      --navy: #06152b;
      --navy-2: #0a2141;
      --blue: #168cff;
      --cyan: #42d8ff;
      --ink: #122440;
      --muted: #60738f;
      --paper: #f5f8fc;
      --line: #e3eaf3;
      --radius: 20px;
      --max: 1160px;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "PingFang SC", "Microsoft YaHei", sans-serif; color: var(--ink);
      background: #fff; line-height: 1.7;
    }
    a { color: inherit; text-decoration: none; }
    button, a { -webkit-tap-highlight-color: transparent; }
    .container { width: min(var(--max), calc(100% - 40px)); margin: 0 auto; }
    .topbar {
      position: sticky; top: 0; z-index: 20; color: #fff;
      background: rgba(5, 19, 39, .92); backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255,255,255,.09);
    }
    .nav { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { display: flex; align-items: center; gap: 11px; font-weight: 800; letter-spacing: -.3px; font-size: 20px; }
    .brand-mark {
      width: 38px; height: 38px; border-radius: 13px; display: grid; place-items: center;
      color: #fff; background: linear-gradient(135deg, var(--blue), #37d9f5);
      box-shadow: 0 7px 24px rgba(22,140,255,.28); font-size: 20px;
    }
    .brand small { display: block; color: #9eb4d2; font-size: 10px; font-weight: 500; letter-spacing: 1px; margin-top: -3px; }
    .navlinks { display: flex; align-items: center; gap: 27px; color: #d4e0f2; font-size: 13px; }
    .navlinks a:hover { color: var(--cyan); }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 9px;
      border: 1px solid transparent; border-radius: 999px; padding: 12px 21px;
      font-weight: 700; font-size: 14px; transition: .2s ease; cursor: pointer;
    }
    .btn-primary { color: #fff; background: linear-gradient(100deg, #138bff, #1bafff); box-shadow: 0 9px 24px rgba(15,137,255,.22); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 13px 28px rgba(15,137,255,.3); }
    .btn-outline { color: #fff; border-color: rgba(255,255,255,.32); background: rgba(255,255,255,.04); }
    .btn-outline:hover { border-color: var(--cyan); color: var(--cyan); }
    .menu-toggle { display: none; color: #fff; border: 1px solid #29415f; border-radius: 10px; background: transparent; padding: 8px 12px; font-size: 20px; }
    .hero {
      overflow: hidden; position: relative; color: #fff; min-height: 560px;
      background:
        radial-gradient(ellipse at 76% 40%, rgba(16,127,255,.25), transparent 38%),
        radial-gradient(ellipse at 65% 100%, rgba(0,220,255,.11), transparent 38%),
        linear-gradient(120deg, #06152b 0%, #082448 60%, #06152b 100%);
    }
    .hero:before {
      content: ""; position: absolute; inset: 0; opacity: .24; pointer-events: none;
      background-image: linear-gradient(rgba(89,170,255,.13) 1px, transparent 1px), linear-gradient(90deg, rgba(89,170,255,.13) 1px, transparent 1px);
      background-size: 44px 44px; mask-image: linear-gradient(90deg, transparent, black 55%, black);
    }
    .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr .95fr; align-items: center; gap: 36px; padding-top: 75px; padding-bottom: 76px; }
    .eyebrow { color: var(--cyan); font-size: 13px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; }
    h1 { margin: 16px 0 20px; font-size: clamp(38px, 5vw, 58px); line-height: 1.2; letter-spacing: -1.8px; }
    h1 span { color: #47b7ff; }
    .hero p { color: #b8cbe4; max-width: 560px; font-size: 16px; margin: 0 0 25px; }
    .checks { display: flex; flex-wrap: wrap; gap: 10px 20px; margin: 24px 0 30px; color: #dce8f7; font-size: 13px; }
    .checks span:before { content: "✓"; display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: 7px; border-radius: 50%; background: #168cff; color: white; font-size: 12px; font-weight: 800; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .visual { position: relative; min-height: 360px; display: grid; place-items: center; }
    .globe {
      width: min(390px, 90%); aspect-ratio: 1; border-radius: 50%; position: relative;
      border: 1px solid rgba(77,194,255,.35);
      background: radial-gradient(circle at 38% 34%, rgba(40,171,255,.32), rgba(13,58,111,.15) 43%, rgba(2,14,33,.35) 68%);
      box-shadow: inset 0 0 55px rgba(33,155,255,.16), 0 0 75px rgba(15,122,255,.15);
    }
    .globe:before, .globe:after { content: ""; position: absolute; inset: 10%; border: 1px solid rgba(67,192,255,.32); border-radius: 50%; transform: rotate(-25deg) scaleX(.46); }
    .globe:after { transform: rotate(55deg) scaleX(.46); }
    .orbit { position: absolute; inset: 22% -10%; border: 1px solid rgba(57,205,255,.55); border-radius: 50%; transform: rotate(-22deg); }
    .orbit.two { inset: 8% -2%; transform: rotate(36deg); border-color: rgba(22,140,255,.5); }
    .node { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: #6eeaff; box-shadow: 0 0 0 6px rgba(66,216,255,.12), 0 0 22px #42d8ff; }
    .n1 { top: 24%; left: 24%; } .n2 { top: 42%; right: 16%; } .n3 { bottom: 23%; left: 38%; } .n4 { top: 61%; right: 31%; }
    .server-stack { position: absolute; right: -2%; bottom: 1%; width: 155px; display: grid; gap: 8px; transform: perspective(500px) rotateY(-10deg); }
    .server-stack i { height: 38px; border: 1px solid #2865a0; border-radius: 7px; background: linear-gradient(110deg, #0b2547, #174a7d); box-shadow: inset 0 0 14px #0c8cff33, 0 8px 18px #0004; position: relative; }
    .server-stack i:after { content: "●  ●  ━━━━━"; color: #36d9ff; font-size: 10px; position: absolute; left: 12px; top: 7px; letter-spacing: 3px; }
    .float-label { position: absolute; left: 0; bottom: 22%; background: rgba(9,31,59,.8); border: 1px solid rgba(90,180,255,.35); border-radius: 13px; padding: 12px 15px; color: #d9efff; font-size: 12px; backdrop-filter: blur(10px); }
    .float-label strong { display: block; color: white; font-size: 14px; }
    section { padding: 78px 0; }
    .section-head { display: flex; justify-content: space-between; align-items: end; gap: 25px; margin-bottom: 30px; }
    .kicker { color: #138bff; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; }
      h2 { margin: 5px 0 8px; color: #102442; font-size: clamp(26px, 3vw, 35px); line-height: 1.3; letter-spacing: -.7px; }
    .section-head p, .intro { margin: 0; color: var(--muted); font-size: 14px; }
    .services { background: #fff; }
    .cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 17px; }
    .card { padding: 25px 23px; border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(145deg, #fff, #f7faff); box-shadow: 0 8px 25px rgba(17,52,94,.035); transition: .2s; }
    .card:hover { transform: translateY(-4px); border-color: #b7d9ff; box-shadow: 0 15px 32px rgba(17,100,180,.09); }
    .iconbox { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 15px; color: #087fff; background: #e8f3ff; font-size: 23px; margin-bottom: 20px; }
    .card h3 { margin: 0 0 9px; font-size: 18px; color: #102442; }
    .card p { margin: 0 0 17px; color: #667a96; font-size: 13px; }
    .text-link { color: #087fff; font-size: 13px; font-weight: 800; }
    .coverage { background: linear-gradient(120deg, #edf5ff, #f7fbff); position: relative; overflow: hidden; }
    .coverage-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 45px; align-items: center; }
    .coverage-copy p { color: #637895; font-size: 14px; }
    .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .stat { padding: 23px; border: 1px solid #e0ebf8; background: rgba(255,255,255,.78); border-radius: 17px; }
    .stat b { display: block; color: #087fff; font-size: 29px; line-height: 1.3; }
    .stat span { font-size: 12px; color: #657b98; }
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; counter-reset: step; }
    .step { border: 1px solid var(--line); border-radius: var(--radius); padding: 25px; }
    .step:before { counter-increment: step; content: "0" counter(step); display: inline-block; color: #148cff; font-size: 13px; font-weight: 900; letter-spacing: 1px; margin-bottom: 13px; }
    .step h3 { margin: 0 0 8px; font-size: 17px; }
    .step p { color: var(--muted); font-size: 13px; margin: 0; }
    .trust { background: var(--navy); color: #fff; }
    .trust h2 { color: #fff; }
    .trust .section-head p { color: #a6bbd6; }
    .trust-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: center; }
    .trust-points { display: grid; gap: 15px; }
    .trust-point { display: flex; gap: 13px; align-items: start; padding: 15px; border: 1px solid rgba(255,255,255,.1); border-radius: 14px; background: rgba(255,255,255,.035); }
    .trust-point b { display: block; font-size: 14px; margin-bottom: 3px; }
    .trust-point span { display: block; color: #a9bed9; font-size: 12px; }
    .trust-symbol { color: #50c8ff; font-size: 21px; }
    .contact { background: #f5f8fc; }
    .contact-panel { display: grid; grid-template-columns: 1fr .9fr; gap: 36px; padding: 38px; border-radius: 26px; color: white; background: radial-gradient(circle at 100% 0, #123f72, transparent 45%), linear-gradient(120deg, #07172e, #0a2a4f); box-shadow: 0 20px 50px rgba(5,30,65,.15); }
    .contact-panel h2 { color: #fff; }
    .contact-panel p { color: #b3c8e1; font-size: 14px; }
    .contact-list { display: grid; gap: 12px; align-content: center; }
    .contact-item { display: flex; align-items: center; gap: 13px; border: 1px solid rgba(255,255,255,.13); border-radius: 13px; padding: 13px 15px; background: rgba(255,255,255,.045); }
    .contact-item .symbol { color: #5bcfff; font-size: 19px; width: 24px; text-align: center; }
    .contact-item small { display: block; color: #91aac9; font-size: 11px; }
    .contact-item strong { font-size: 14px; overflow-wrap: anywhere; }
    footer { background: #041126; color: #9eb3cf; padding: 30px 0; font-size: 12px; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 18px; }
    .footer-links a:hover { color: white; }
    .note { margin-top: 15px; color: #758ba8; font-size: 11px; }
    @media (max-width: 900px) {
      .navlinks { gap: 15px; } .navlinks a:nth-child(4), .navlinks a:nth-child(5) { display: none; }
      .hero-inner { grid-template-columns: 1fr 0.8fr; gap: 15px; }
      .cards { grid-template-columns: repeat(2, 1fr); }
      .coverage-grid { gap: 25px; }
    }
    @media (max-width: 680px) {
      .container { width: min(100% - 30px, var(--max)); }
      .nav { min-height: 64px; flex-wrap: wrap; }
      .menu-toggle { display: block; }
      .nav > .btn { display: none; }
      .navlinks { display: none; width: 100%; padding: 0 0 17px; flex-direction: column; align-items: stretch; gap: 0; }
      .navlinks.open { display: flex; }
      .navlinks a { display: block !important; padding: 10px 0; border-top: 1px solid rgba(255,255,255,.08); }
      .hero-inner { grid-template-columns: 1fr; padding-top: 56px; padding-bottom: 45px; }
      h1 { font-size: 39px; }
      .visual { min-height: 285px; }
      .globe { width: 270px; }
      .server-stack { width: 110px; right: 3%; }
      .float-label { left: 1%; bottom: 12%; }
      section { padding: 57px 0; }
      .section-head { align-items: start; flex-direction: column; gap: 10px; }
      .cards { grid-template-columns: 1fr; }
      .card { padding: 22px; }
      .coverage-grid, .trust-grid, .contact-panel { grid-template-columns: 1fr; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .steps { grid-template-columns: 1fr; }
      .contact-panel { padding: 25px 20px; gap: 20px; }
      .footer-inner { align-items: start; flex-direction: column; }
    }
  </style>
</head>
<body>
  <!-- 品牌名称：搜索并替换 GlobalNet 即可修改 -->
  <header class="topbar">
    <div class="container nav">
